#!/usr/bin/env bash
# Fake git: "clone" copies $STUB_CLONE_SRC, "ls-remote" follows STUB_REPO,
# init/add succeed, everything else behaves like "not a git repo".
while [[ "${1:-}" == -C || "${1:-}" == -c ]]; do shift 2; done
case "${1:-}" in
  clone) mkdir -p "${@: -1}" && cp -a "$STUB_CLONE_SRC/." "${@: -1}/" ;;
  ls-remote) exit "${STUB_REPO:-1}" ;;
  init|add) exit 0 ;;
  *) exit 1 ;;
esac
