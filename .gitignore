# Files that are created while building or testing. They never belong on Git or the USB stick.
result
result-*
*.qcow2
.nix-portable/

# Secrets. This repo is public, so these must never be committed (.githooks/pre-commit checks as well).
.env
.env.*
secrets/
secret/
*.pem
*.key
*.p12
*.pfx
*.kdbx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*password*

# Local development and test tools; not needed for installing, so not on GitHub.
dev/

# Notes for the AI assistant (Claude Code); kept locally only.
CLAUDE.md

# The choices of step 4 of the installer (machine name etc.); stays on the machine.
.install-choice
